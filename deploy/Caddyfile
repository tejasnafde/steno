# Two hostnames, one Caddy.
#  PUBLIC_HOST is DNS-only and served direct with a Let's Encrypt certificate: from India, Cloudflare's
#  Mumbai colo stalled 5 to 17 s on 40 percent of requests to a US origin, the raw path does not.
#  ADMIN_HOST is proxied by Cloudflare so Access can gate it; the zone runs SSL mode "full", so Caddy's
#  own CA is enough there. Ports 80 and 443 are open to the world; 80 exists for the ACME challenge.
{$PUBLIC_HOST} {
  encode zstd gzip
  redir /admin* https://{$ADMIN_HOST}{uri} 308
  redir /api/admin/* https://{$ADMIN_HOST}{uri} 308
  reverse_proxy chat:8000 {
    flush_interval -1
  }
}

https://{$ADMIN_HOST} {
  tls internal
  encode zstd gzip
  @adminapp path /admin/access /api/admin/*
  handle @adminapp {
    reverse_proxy chat:8000
  }
  handle /admin* {
    reverse_proxy grafana:3000
  }
  handle {
    redir * /admin/ 302
  }
}

# Served direct (DNS-only) with a Let's Encrypt certificate. Port 80 exists for the ACME challenge.
# /admin is Grafana; Caddy asks the chat app whether the signed-in user is on the allowlist first.
{$PUBLIC_HOST} {
  encode zstd gzip
  @adminapp path /admin/access /api/admin/*
  handle @adminapp {
    reverse_proxy chat:8000
  }
  handle /admin* {
    forward_auth chat:8000 {
      uri /api/admin/check
    }
    reverse_proxy grafana:3000
  }
  handle {
    reverse_proxy chat:8000 {
      flush_interval -1
    }
  }
}

# Served direct (DNS-only) with a Let's Encrypt certificate. Port 80 exists for the ACME challenge.
# /admin is Grafana; Caddy asks the chat app whether the signed-in user is on the allowlist first.
# lb_try_duration: a rollout recreates the chat container and it needs 15 to 20 s to start on this VM;
# waiting for the upstream beats answering 502 for that window.
{$PUBLIC_HOST} {
  encode zstd gzip
  @adminapp path /admin/access /api/admin/*
  handle @adminapp {
    reverse_proxy chat:8000 {
      lb_try_duration 40s
      lb_try_interval 1s
    }
  }
  handle /admin* {
    forward_auth chat:8000 {
      uri /api/admin/check
      lb_try_duration 40s
      lb_try_interval 1s
    }
    reverse_proxy grafana:3000 {
      lb_try_duration 40s
      lb_try_interval 1s
    }
  }
  handle {
    reverse_proxy chat:8000 {
      flush_interval -1
      lb_try_duration 40s
      lb_try_interval 1s
    }
  }
}

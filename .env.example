# Copy to .env. Set at least one provider key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Comma separated emails allowed to open /admin. Editable later at /admin/access.
ADMIN_EMAILS=
# Signs the login cookie. Any long random string; change it to log everyone out.
SESSION_SECRET=
# Limits for the free chat (per IP per minute; per identity per 24 h). Requests on a visitor's own key skip the daily caps.
BURST_PER_MINUTE=10
DAILY_MESSAGES_ANON=20
DAILY_TOKENS_ANON=60000
DAILY_MESSAGES_USER=100
DAILY_TOKENS_USER=400000

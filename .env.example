# Copy to .env. Set at least one provider key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Comma separated emails allowed to open /admin. Editable later at /admin/access.
ADMIN_EMAILS=
# Signs the login cookie. Any long random string; change it to log everyone out.
SESSION_SECRET=
